# ==============================================================================
# Progressive Credential Loading (PCL) Configuration
# Repository: k8s-secret-rotation-operator
# ==============================================================================
#
# TIER 1: ZERO-SETUP / LOCAL DEV / CI (Default)
# - Local mock secret rotation and TLS self-signed certificates.
#
# TIER 2 / TIER 3: PRODUCTION VAULT / AWS SECRETS MANAGER
# - Connect operator to external secrets manager.

VAULT_ADDR=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ROTATION_INTERVAL_MINUTES=60
